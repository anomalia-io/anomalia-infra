[Unit]
Description=Anomalia Pyroscope Continuous Profiling Service
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0
[Service]
User=root
ExecStart=/usr/local/bin/pyroscope server -logger-level=info -data-path={{ pyroscope_storage_path }} -server-port=:{{ pyroscope_port | default('4040') }}
Restart=always

[Install]
WantedBy=multi-user.target

[Unit]
Description=Aplica el aislamiento de red de los puertos de lectura de Victoria (Anomalia)
After=network-online.target {{ anomalia_engine_service }}
Wants=network-online.target
Requires={{ anomalia_engine_service }}
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/etc/anomalia/firewall/apply-victoria-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
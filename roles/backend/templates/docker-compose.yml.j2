{#- El gateway TLS existe siempre; 80/443 dependen del certificado externo -#}
{% set tls_enabled = certs_external_enabled | default(false) | bool %}
version: '3.8'

networks:
  anomalia_aiops-net:
    external: true

services:
  postgres:
    image: postgres:15-alpine
    container_name: anomalia_postgres
    environment:
      POSTGRES_USER: anomal_user
      POSTGRES_PASSWORD: anomal_password
      POSTGRES_DB: anomal_db
    ports:
      - "5432:5432"
    volumes:
      - ./database/init.sql:/docker-entrypoint-initdb.d/init.sql
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U anomal_user -d anomal_db"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - anomalia_aiops-net
    restart: unless-stopped

  ollama:
    image: ollama/ollama:latest
    container_name: anomalia_ollama
    ports:
      - "11434:11434"
    volumes:
      - ollama_data:/root/.ollama
    environment:
      - OLLAMA_NUM_PARALLEL=2
      - OLLAMA_MAX_LOADED_MODELS=1
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 6G
    networks:
      - anomalia_aiops-net
    restart: unless-stopped

  anomaliagw:
    build: .
    container_name: anomalia_gw
    ports:
      - "8000:8000"
    environment:
      - DATABASE_URL=postgresql://anomal_user:anomal_password@postgres:5432/anomal_db
      - AI_PROVIDER=ollama
      - OLLAMA_HOST=http://anomalia_ollama:11434
      - OLLAMA_MODEL={{ ollama_model }}
      - AI_TIMEOUT_SECONDS={{ ai_timeout_seconds | default(120) }}
      - OLLAMA_NUM_PREDICT={{ ollama_num_predict | default(384) }}
      - PYROSCOPE_APPLICATION_NAME=anomalia_system
      - PUBLIC_EXTERNAL_PORT={{ '443' if tls_enabled else '80' }}
      - FORCE_HTTPS=false
      # spec 018: token compartido que Alertmanager presenta como Bearer en el
      # webhook. Vacío = webhook abierto (instalaciones internas / desarrollo).
      - ALERTMANAGER_WEBHOOK_TOKEN={{ alertmanager_webhook_token | default('') }}

      # Endpoints limpios inyectados desde Ansible (defaults/main.yml)
      - PYROSCOPE_SERVER_ADDRESS={{ backend_pyroscope_address }}
      - OTEL_EXPORTER_OTLP_TRACES_ENDPOINT={{ backend_otel_traces_endpoint }}
      - OTEL_EXPORTER_OTLP_METRICS_ENDPOINT={{ backend_otel_metrics_endpoint }}
      - AUDIT_LOGS_ENDPOINT={{ backend_audit_logs_endpoint }}

      # Provisioning de Parses (spec 008). El proxy de datasources usa el
      # listener TLS interno de Nginx; el certificado interno no depende del
      # certificado público provisto por el operador.
      - PARSES_API_URL={{ backend_parses_base_url }}/api/v1
      - PARSES_MIGRATE_URL={{ backend_parses_base_url }}/api/migrate
      - PARSES_UI_URL={{ backend_parses_base_url }}
      - PARSES_PROXY_BASE={{ backend_parses_proxy_base }}
      - PARSES_PROXY_TOKEN_TTL=86400
      - PARSES_TLS_CA_FILE=/certs/internal/ca.crt
    volumes:
      - /opt/anomalia/backend:/opt/anomalia/backend
      - /opt/anomalia/backend/media:/app/media
      - /opt/anomalia/backend/playbooks:/opt/anomalia/backend/playbooks
      - /opt/anomalia/certs:/certs:ro
      - "{{ anomalia_container_socket }}:/var/run/docker.sock"
    command: "uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*"
    user: "root"
    labels:
      scrape: "true"
      port: "8000"
      path: "/metrics"
    extra_hosts:
      - "{{ certs_hostname | default('anomalia.local') }}:{{ anomalia_extra_host_gateway }}"
    depends_on:
      postgres:
        condition: service_healthy
      ollama:
        condition: service_started
    networks:
      - anomalia_aiops-net
    restart: unless-stopped

  anomaliagw_tls:
    image: "{{ anomalia_nginx_image }}"
    container_name: anomalia_gw_tls
    ports:
{% if tls_enabled %}
      - "80:80"
      - "443:443"
{% else %}
      - "80:80"
{% endif %}
    expose:
      - "8443"
    volumes:
      - ./nginx-tls.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx-proxy.inc:/etc/nginx/snippets/anomalia-proxy.conf:ro
      - /opt/anomalia/certs:/certs:ro
    healthcheck:
      test: ["CMD-SHELL", "nginx -t"]
      interval: 30s
      timeout: 5s
      retries: 3
    depends_on:
      anomaliagw:
        condition: service_started
    networks:
      anomalia_aiops-net:
        aliases:
          - anomalia_gw_tls
    restart: unless-stopped

volumes:
  ollama_data:
  postgres_data:
